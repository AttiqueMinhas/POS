@model POS.Data.Models.ProductModel;

<div class="Container px-5">
    <div class="card mt-5">
        <div class="card-header">
            <div class="row">
                <div class="col-6 fw-bold text-secondary">Add New Product</div>
            </div>
        </div>
        <div class="card-body">
            <form method="post" asp-controller="Product" asp-action="AddEditProduct" enctype="multipart/form-data">
                <input type="hidden" asp-for="Product_Id" class="form-control" />

                <div class="row mb-2">
                    <div class="col-6">
                        <div class="row">
                            <div class="col-3 d-flex justify-content-end">
                                <label asp-for="Product_Name" class="control-label">Product Name</label>
                            </div>
                            <div class="col-8">
                                <input type="text" asp-for="Product_Name" class="form-control" required />
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="row">
                            <div class="col-3 d-flex justify-content-end">
                                <label asp-for="BarCode" class="control-label">BarCode</label>
                            </div>
                            <div class="col-8">
                                <input type="text" asp-for="BarCode" class="form-control" required />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-6">
                        <div class="row">
                            <div class="col-3 d-flex justify-content-end">
                                <label asp-for="Price" class="control-label">Price</label>
                            </div>
                            <div class="col-8">
                                <input type="text" asp-for="Price" class="form-control" required />
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="row">
                            <div class="col-3 d-flex justify-content-end">
                                <label asp-for="Brand" class="control-label">Brand</label>
                            </div>
                            <div class="col-8">
                                <input type="text" asp-for="Brand" class="form-control" required />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-6">
                        <div class="row">
                            <div class="col-3 d-flex justify-content-end">
                                <label asp-for="Category_ID" class="control-label">Categories</label>
                            </div>
                            <div class="col-8">
                                <select class="form-control" asp-for="Category_ID" asp-items="@(new SelectList(Model.Categories,"Category_ID","Category_Name"))">
                                    <option value="-1">---Select Category---</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="row">
                            <div class="col-3 d-flex justify-content-end">
                                <label asp-for="Quantity" class="control-label">Quantity</label>
                            </div>
                            <div class="col-8">
                                <input type="text" asp-for="Quantity" class="form-control" required />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-6">
                        <div class="row">
                            <div class="col-3 d-flex justify-content-end">
                                <label asp-for="Image" class="control-label">Image</label>
                            </div>
                            <div class="col-8">
                                <input type="file" asp-for="Image" class="form-control" required />
                                <span>@ViewBag.img</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="row">
                            <div class="col-3 d-flex justify-content-end">
                                <label asp-for="Status" class="control-label">Status</label>
                            </div>
                            <div class="col-8">
                                <select asp-for="Status" class="form-control">
                                    <option value="default"> Select Status</option>
                                    <option value="True">True</option>
                                    <option value="False">False</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-9">
                        <div class="row mb-2">
                            <div class="col-2 d-flex justify-content-end">
                                <label asp-for="Description" class="control-label">Description</label>
                            </div>
                            <div class="col-10">
                                <textarea asp-for="Description" class="form-control" required></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="d-flex justify-content-end">
                        <div class="me-2"><button type="submit" class="btn btn-primary">Save</button></div>
                        <div><a type="button" class="btn btn-danger" asp-action="products" asp-controller="Product">Cancel</a></div>
                        
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

