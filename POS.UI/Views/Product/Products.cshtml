@using POS.Data.Models;
@model IEnumerable<ProductModel>


<div class="Container">
    <div class="card mt-5">
        <div class="card-header">
            <div class="row">
                <div class="col-6 fw-bold text-secondary">Products</div>
                <div class="col-6 d-flex justify-content-end">
                    <a class="btn btn-primary" asp-action="AddEditProduct" asp-controller="Product">Add Product</a>
                </div>
            </div>
        </div>
        <div class="card-body">
            <table id="myProductTable" class="table table-striped table-bordered dt-responsive nowrap" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>Photo</th>
                        <th>Brand</th>
                        <th>Product Name</th>
                        <th>Quantity</th>
                        <th>Price</th>
                        <th>State</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>
                                <img src="@Url.Content(product.IPath)" style="width:100px;height:100px;" />
                            </td>
                            <td>@product.Brand</td>
                            <td>@product.Product_Name</td>
                            <td>@product.Quantity</td>
                            <td>@product.Price</td>
                            @if (product.Status)
                            {
                                <td>Active</td>
                            }
                            else
                            {
                                <td>Not Active</td>
                            }

                            <td>
                                <a class="btn btn-info" asp-action="AddEditProduct" asp-controller="Product" asp-route-id="@product.Product_Id" title="Edit"><i class="fa-regular fa-pen-to-square"></i></a>
                                <a class="btn btn-danger" asp-action="DeleteProduct" asp-controller="Product" asp-route-id="@product.Product_Id" title="Delete"><i class="fa-regular fa-trash-can"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/app/js/product.js" asp-append-version="true"></script>
}
