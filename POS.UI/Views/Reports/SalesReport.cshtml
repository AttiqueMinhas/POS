@using POS.Data.Models.ModelVM.Response
@model IEnumerable<SalesReportResponse>
@{
    ViewData["Title"] = "SalesReport";
}
@* @section styles {
    <link href="~/app/css/salesReport.css" rel="stylesheet" />
} *@
<div class="container">
    <div class="card shadow">
        <div class="card-header">Sales Report</div>
        <div class="card-body">
            <form asp-controller="Reports" asp-action="GetSaleReportData" method="post">
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label>Start Date</label>
                        <div class="input-group date dpicker">
                            <input type="text" class="form-control pt-0 pb-0" id="txtStartDate" name="StartDate">
                            <div class="input-group-append">
                                <span class="input-group-text"><i class="fa fa-calendar"></i></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label>End Date</label>
                        <div class="input-group date dpicker">
                            <input type="text" class="form-control pt-0 pb-0" id="txtEndDate" name="EndDate">
                            <div class="input-group-append">
                                <span class="input-group-text"><i class="fa fa-calendar"></i></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button id="btnSearch" type="submit" class="btn btn-success btn-sm btn-block w-100">Search</button>
                    </div>
                </div>
            </form>
            

            <div class="table-responsive" style="height: 600px;">
                <table id="saleReportTable" class="table table-striped table-bordered nowrap" style="width:100%">
                    <thead>
                        <tr>
                            <th>Registration Date</th>
                            <th>Sale Number</th>
                            <th>Document Type</th>
                            <th>Client Document</th>
                            <th>Client Name</th>
                            <th>Subtotal</th>
                            <th>Tax</th>
                            <th>Total Sale</th>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Price</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var data in Model)
                        {
                            <tr>
                                <td>@data.RegistrationDate</td>
                                <td>@data.SaleNumber</td>
                                <td>@data.RegistrationDate</td>
                                <td>@data.DocumentType</td>
                                <td>@data.ClientDocument</td>
                                <td>@data.SubTotalSale</td>
                                <td>@data.TaxTotalSale</td>
                                <td>@data.TotalSale</td>
                                <td>@data.Product</td>
                                <td>@data.Quantity</td>
                                <td>@data.Price</td>
                                <td>@data.Total</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>



@section Scripts {

    <script src="~/app/js/SaleReport.js" asp-append-version="true"></script>
}
